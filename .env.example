# Copy to .env and fill in. NEVER commit .env.

# --- Mode -------------------------------------------------------------------
# true  = deterministic mock LLM + mock embeddings + local-file "S3". No API keys needed.
# false = real OpenAI-compatible LLM/embeddings and real S3.
MOCK_MODE=true

# --- CockroachDB Cloud (Free Tier) ------------------------------------------
# From the CockroachDB Cloud console: Connect > General connection string.
# Rewrite the scheme to cockroachdb:// for langchain-cockroachdb.
# cockroachdb://<user>:<pass>@<host>:26257/<db>?sslmode=verify-full
COCKROACH_DB_URL=

# Table names (created by scripts/init_db.py).
# The LangGraph checkpoint tables (checkpoints, checkpoint_blobs, checkpoint_writes,
# checkpoint_migrations) are named by the library and cannot be configured.
VECTOR_TABLE=guardian_memory
CHAT_TABLE=guardian_chat_history

# Embedding width. 1536 = OpenAI text-embedding-3-small. Mock embedder uses the same
# number so you can swap MOCK_MODE without re-creating the table.
EMBED_DIM=1536

# --- LLM (ignored when MOCK_MODE=true) --------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# --- AWS ---------------------------------------------------------------------
# S3_BUCKET alone decides where contracts are archived — MOCK_MODE does not affect it.
# Leave it empty to write to .local_s3/ instead; set it to use real S3.
# AWS_REGION is provided automatically when running on Lambda.
AWS_REGION=us-east-1
S3_BUCKET=
